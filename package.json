{
  "name": "owego",
  "version": "1.0.7",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "android": "react-native run-android",
    "android:bundle:prod": "scripts/android/build.sh --env production --store play --artifact aab",
    "android:clean": "cd android && ./gradlew clean",
    "android:deploy:prod": "cd android && bundle exec fastlane android release_production",
    "android:deploy:stg": "cd android && bundle exec fastlane android release_staging",
    "android:dev": "ENVFILE=.env.development react-native run-android --mode developmentPlayDebug --appIdSuffix dev",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode productionPlayDebug",
    "android:release:dapp:prod": "scripts/android/build.sh --env production --store dappStore",
    "android:release:dapp:stg": "scripts/android/build.sh --env staging --store dappStore",
    "android:release:dev": "scripts/android/build.sh --env development",
    "android:release:prod": "scripts/android/build.sh --env production",
    "android:release:stg": "scripts/android/build.sh --env staging",
    "android:signing:artifact": "scripts/android/print-artifact-signer.sh",
    "android:signing:sha": "scripts/android/print-signing-sha.sh",
    "android:stg": "ENVFILE=.env.staging react-native run-android --mode stagingPlayDebug --appIdSuffix stg",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.js --output-type archi | dot -Tsvg > dependency-graph.svg",
    "deps:check": "npm outdated || true",
    "format": "prettier --write .",
    "ios": "react-native run-ios",
    "ios:deploy:prod": "scripts/ios/build.sh --env production --upload",
    "ios:deploy:stg": "scripts/ios/build.sh --env staging --upload",
    "ios:dev": "ENVFILE=.env.development react-native run-ios --scheme Development",
    "ios:pods": "cd ios && bundle exec pod install",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --scheme Production",
    "ios:release:prod": "scripts/ios/build.sh --env production",
    "ios:release:stg": "scripts/ios/build.sh --env staging",
    "ios:signing:sync": "cd ios && bundle exec fastlane ios sync_signing",
    "ios:stg": "ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "ios:upload:prod": "scripts/ios/upload.sh --env production",
    "ios:upload:stg": "scripts/ios/upload.sh --env staging",
    "knip": "knip",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "react-native start",
    "start:dev": "ENVFILE=.env.development react-native start",
    "start:prod": "ENVFILE=.env.production react-native start",
    "start:stg": "ENVFILE=.env.staging react-native start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "type-coverage": "type-coverage --at-least 98 --strict --ignore-files \"src/**/*.test.*\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm run type-coverage && npm test"
  },
  "dependencies": {
    "@circle-fin/w3s-pw-react-native-sdk": "2.2.5",
    "@d11/react-native-fast-image": "^8.13.0",
    "@didit-protocol/sdk-react-native": "^4.7.3",
    "@hookform/resolvers": "^5.9.1",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.3.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-google-signin/google-signin": "^14.0.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@shopify/flash-list": "^2.3.2",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.3.0",
    "@solana-program/token": "0.15.0",
    "@solana/kit": "~7.1.1",
    "@tanstack/react-query": "^5.101.4",
    "awilix": "^13.0.5",
    "axios": "^1.19.0",
    "country-flag-icons": "^1.6.20",
    "dinero.js": "^2.0.2",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-modules-core": "~57.0.19",
    "i18next": "^26.3.6",
    "lottie-react-native": "^7.5.0",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-biometrics": "^3.0.1",
    "react-native-bootsplash": "^7.3.2",
    "react-native-device-info": "^15.0.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.7.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "~1.1.7",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react-native-dotenv": "^4.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
